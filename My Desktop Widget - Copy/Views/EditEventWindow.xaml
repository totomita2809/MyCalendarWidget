<Window x:Class="MyCalendarWidget.Views.EditEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chỉnh sửa sự kiện" Height="620" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">

    <Border Background="#F21A1A1A" CornerRadius="20" BorderBrush="#44FFFFFF" BorderThickness="1" 
            MouseLeftButtonDown="Border_MouseLeftButtonDown" Cursor="Arrow">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="CHỈNH SỬA SỰ KIỆN" Foreground="Beige" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Separator Background="#33FFFFFF" Margin="0,10,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Tiêu đề" Foreground="#AAFFFFFF" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtTitle" Background="#2A2A35" Foreground="White" BorderThickness="0" Padding="10" Margin="0,0,0,15"/>

                    <TextBlock Text="Ngày bắt đầu" Foreground="#AAFFFFFF" FontSize="12" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpStartDate" Background="#2A2A35" Margin="0,0,0,10"/>

                    <TextBlock Text="Ngày kết thúc" Foreground="#AAFFFFFF" FontSize="12" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpEndDate" Background="#2A2A35" Margin="0,0,0,10"/>

                    <TextBlock Text="Thời gian cụ thể" Foreground="#AAFFFFFF" FontSize="12" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBox x:Name="txtStartTime" Width="60" Background="#2A2A35" Foreground="White" BorderThickness="0" Padding="8" TextAlignment="Center"/>
                        <TextBlock Text="-" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBox x:Name="txtEndTime" Width="60" Background="#2A2A35" Foreground="White" BorderThickness="0" Padding="8" TextAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Địa điểm" Foreground="#AAFFFFFF" FontSize="12" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <TextBox x:Name="txtLocation" Background="#2A2A35" Foreground="White" BorderThickness="0" Padding="10" TextChanged="TxtLocation_TextChanged"/>
                        <ListBox x:Name="lstLocationSuggestions" Visibility="Collapsed" MaxHeight="100" Background="#1E1E24" Foreground="White" BorderBrush="#44FFFFFF" Margin="0,35,0,0" SelectionChanged="LstLocationSuggestions_SelectionChanged"/>
                    </Grid>

                    <TextBlock Text="Ghi chú" Foreground="#AAFFFFFF" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNotes" Background="#2A2A35" Foreground="White" BorderThickness="0" Padding="10" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

                    <StackPanel x:Name="panelAttendees">
                        <TextBlock Text="Mời người tham gia (Email)" Foreground="#AAFFFFFF" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtAttendees" Background="#2A2A35" Foreground="White" BorderThickness="0" Padding="10" Margin="0,0,0,10"/>
                        <TextBlock x:Name="txtGuestWarning" Text="Vui lòng đăng nhập Google để mời bạn bè" Foreground="#FF5555" FontSize="11" FontStyle="Italic" Visibility="Collapsed" Margin="0,0,0,10"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Hủy bỏ" Click="BtnCancel_Click" Background="Transparent" Foreground="White" BorderThickness="0" Margin="0,0,15,0" Cursor="Hand"/>
                <Button x:Name="btnSave" Content="Cập nhật" Click="BtnSave_Click" Background="Beige" Foreground="Black" FontWeight="Bold" Padding="25,10" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>