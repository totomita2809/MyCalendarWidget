<Window x:Class="MyCalendarWidget.Views.DeletedHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lịch sử xóa" Height="540" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">

    <Border Background="#F21A1A1A" CornerRadius="20" BorderBrush="Cyan" BorderThickness="1" 
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.8" Color="Cyan"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="SỰ KIỆN ĐÃ XÓA GẦN ĐÂY" Foreground="Cyan" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Dữ liệu sẽ tự động dọn dẹp sau 7 ngày" Foreground="#66FFFFFF" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <Separator Background="#33FFFFFF" Margin="0,10,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="lstDeletedEvents">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2A2A35" CornerRadius="10" Margin="0,0,5,10" Padding="15,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Summary}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DeletedAt, StringFormat='Xóa lúc: {0:HH:mm dd/MM/yyyy}'}" Foreground="#88FFFFFF" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Khôi phục" Click="BtnRestore_Click" Tag="{Binding}"
                                            Foreground="Black" Background="Cyan" Padding="12,5" FontWeight="Bold" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Row="2" Content="Đóng cửa sổ" Click="BtnClose_Click" 
                    Foreground="#AAFFFFFF" Background="Transparent" BorderThickness="0" 
                    HorizontalAlignment="Center" Margin="0,15,0,0" Cursor="Hand"/>
        </Grid>
    </Border>
</Window>