<Window x:Class="MyCalendarWidget.Views.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác nhận" Height="250" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">

    <Border Background="#F21A1A1A" CornerRadius="20" BorderBrush="#FF5555" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#FF5555"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <TextBlock Text="⚠️" Foreground="Yellow"  FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="XÁC NHẬN XÓA" Foreground="#FF5555" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="txtMessage" Text="Bạn có chắc chắn muốn xóa sự kiện này?" 
                           Foreground="White" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="txtEventTitle" Text="Tên sự kiện" Foreground="#AAAAAA" 
                           FontSize="13" FontStyle="Italic" TextAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button x:Name="btnNo" Content="Hủy bỏ" Click="BtnNo_Click" Width="100" Height="35"
                        Background="Transparent" Foreground="White" BorderBrush="#44FFFFFF" BorderThickness="1" Cursor="Hand" Margin="0,0,20,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnYes" Content="Đồng ý Xóa" Click="BtnYes_Click" Width="120" Height="35"
                        Background="#FF5555" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>