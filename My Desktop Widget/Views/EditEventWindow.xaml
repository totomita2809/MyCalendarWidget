<Window x:Class="MyCalendarWidget.Views.EditEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chỉnh sửa sự kiện" SizeToContent="Height" MinHeight="500" MaxHeight="680" Width="550"
        WindowStyle="None" AllowsTransparency="True" Background="#F21A1A1A"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">

    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#22252A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="5,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding Content}"/>
                                                <Path Grid.Column="1" Name="Arrow" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,3,30,3" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Name="DropDownBorder" Background="#2D3035" BorderThickness="1" BorderBrush="#66FFFFFF" CornerRadius="8" Margin="0,2,0,0"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44F5F5DC"/>
                    <Setter Property="Foreground" Value="Beige"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#22F5F5DC"/>
                    <Setter Property="Foreground" Value="Beige"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuggestionBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#F2252930"/>
            <Setter Property="BorderBrush" Value="Beige"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="MaxHeight" Value="150"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#44F5F5DC"/>
                                <Setter Property="Foreground" Value="Beige"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="Beige" BorderThickness="1.5" CornerRadius="15" Padding="15" Background="#F21A1A1A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="CHỈNH SỬA SỰ KIỆN" Foreground="Beige" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Tiêu đề" Foreground="#88FFFFFF" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtSummary" Background="#22252A" Foreground="White" BorderBrush="#44FFFFFF" Padding="10,8" Margin="0,0,0,15" FontSize="14" CaretBrush="White"/>

                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" Margin="0,0,0,15" Padding="0,0,0,15">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="chkAllDay" Content="Cả ngày" Foreground="White" VerticalAlignment="Center" Click="ChkAllDay_Click"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="🔄 Lặp lại: " Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <ComboBox x:Name="cbRecurrence" Width="140">
                                        <ComboBoxItem Content="Không lặp" IsSelected="True" Tag="NONE"/>
                                        <ComboBoxItem Content="Hằng ngày" Tag="DAILY"/>
                                        <ComboBoxItem Content="Hằng tuần" Tag="WEEKLY"/>
                                        <ComboBoxItem Content="Hằng tháng" Tag="MONTHLY"/>
                                        <ComboBoxItem Content="Hằng năm" Tag="YEARLY"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ngày bắt đầu" Foreground="#88FFFFFF" FontSize="12" Margin="0,0,0,5"/>
                                    <DatePicker x:Name="dpStart" SelectedDateChanged="DpStart_SelectedDateChanged"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="➔" Foreground="#44FFFFFF" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ngày kết thúc" Foreground="#88FFFFFF" FontSize="12" Margin="0,0,0,5"/>
                                    <DatePicker x:Name="dpEnd" SelectedDateChanged="DpEnd_SelectedDateChanged"/>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="gridTimePickers" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Giờ bắt đầu" Foreground="#88FFFFFF" FontSize="11" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cbTimeStart" SelectionChanged="CbTimeStart_SelectionChanged"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="-" Foreground="#44FFFFFF" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Giờ kết thúc" Foreground="#88FFFFFF" FontSize="11" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cbTimeEnd" SelectionChanged="CbTimeEnd_SelectionChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="🔔 Thông báo nhắc nhở trước" Foreground="#88FFFFFF" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbReminders" Margin="0,0,0,15">
                        <ComboBoxItem Content="Không nhắc nhở" Tag="-1"/>
                        <ComboBoxItem Content="Trước 5 phút" Tag="5" IsSelected="True"/>
                        <ComboBoxItem Content="Trước 15 phút" Tag="15"/>
                        <ComboBoxItem Content="Trước 30 phút" Tag="30"/>
                        <ComboBoxItem Content="Trước 1 tiếng" Tag="60"/>
                        <ComboBoxItem Content="Trước 1 ngày" Tag="1440"/>
                    </ComboBox>

                    <Grid Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="📍 Địa điểm" Foreground="#88FFFFFF" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtLocation" Background="#22252A" Foreground="White" BorderBrush="#44FFFFFF" Padding="10,8" FontSize="13" CaretBrush="White" TextChanged="TxtLocation_TextChanged" PreviewKeyDown="TxtLocation_PreviewKeyDown"/>
                            <Popup x:Name="popLocationSuggestions" PlacementTarget="{Binding ElementName=txtLocation}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
                                <ListBox x:Name="lstLocationSuggestions" Style="{StaticResource SuggestionBoxStyle}" Width="390" SelectionChanged="LstLocationSuggestions_SelectionChanged"/>
                            </Popup>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Trạng thái hiển thị" Foreground="#88FFFFFF" FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cbShowAs">
                                <ComboBoxItem Content="💼 Bận (Busy)" Tag="opaque" IsSelected="True"/>
                                <ComboBoxItem Content="🍃 Rảnh (Free)" Tag="transparent"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Chế độ riêng tư" Foreground="#88FFFFFF" FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cbVisibility">
                                <ComboBoxItem Content="🌍 Mặc định công khai" Tag="default" IsSelected="True"/>
                                <ComboBoxItem Content="🔒 Riêng tư (Private)" Tag="private"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="📝 Ghi chú" Foreground="#88FFFFFF" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtDescription" Background="#22252A" Foreground="White" BorderBrush="#44FFFFFF" Padding="10,8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15" FontSize="13" CaretBrush="White"/>

                    <Grid Margin="0,0,0,5">
                        <StackPanel>
                            <TextBlock Text="👥 Mời người tham gia" Foreground="#88FFFFFF" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtAttendees" Background="#22252A" Foreground="White" BorderBrush="#44FFFFFF" Padding="10,8" FontSize="13" CaretBrush="White" TextChanged="TxtAttendees_TextChanged" PreviewKeyDown="TxtAttendees_PreviewKeyDown"/>
                            <Popup x:Name="popAttendeeSuggestions" PlacementTarget="{Binding ElementName=txtAttendees}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
                                <ListBox x:Name="lstAttendeeSuggestions" Style="{StaticResource SuggestionBoxStyle}" Width="390" SelectionChanged="LstAttendeeSuggestions_SelectionChanged"/>
                            </Popup>

                            <StackPanel x:Name="panelGuestWarning" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                                <TextBlock Text="⚠️ Chức năng này cần " Foreground="#FFBB00" FontSize="12" VerticalAlignment="Center"/>
                                <Button Content="Đăng nhập Google" Foreground="Cyan" Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="12" Click="BtnLoginFromWarning_Click" VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text=" để sử dụng." Foreground="#FFBB00" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Hủy bỏ" Click="BtnCancel_Click" Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="10,8"/>
                <Button Grid.Column="1" x:Name="btnSave" Content="Cập nhật" Click="BtnSave_Click" Background="Beige" Foreground="Black" FontWeight="Bold" Padding="25,10" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>