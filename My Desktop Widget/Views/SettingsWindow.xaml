<Window x:Class="MyCalendarWidget.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt" Height="250" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Border Style="{StaticResource WidgetBorderStyle}">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Đóng cửa sổ này" Click="MenuClose_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CÀI ĐẶT ĐỘ MỜ" Foreground="White" 
                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Slider x:Name="OpacitySlider" 
                    Minimum="0.1" 
                    Maximum="1.0" 
                    TickFrequency="0.05"
                    IsSnapToTickEnabled="True"
                    ValueChanged="OpacitySlider_ValueChanged" 
                    Margin="20,0"/>

            <Button Content="ĐÓNG" Click="MenuClose_Click" Margin="0,20,0,0"
                    Background="#33FFFFFF" Foreground="White" BorderThickness="0" Height="30" Width="100"/>
        </StackPanel>
    </Border>
</Window>