<Window x:Class="MyCalendarWidget.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendar Widget" 
        Height="700" Width="900" MinHeight="700" MinWidth="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual" ResizeMode="CanResize" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="TagButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8EAED"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonthNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="Cyan"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PickerMonthButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,8"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4400FFFF"/>
                    <Setter Property="Foreground" Value="Cyan"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WelcomeGoogleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2200FFFF"/>
            <Setter Property="Foreground" Value="Cyan"/>
            <Setter Property="BorderBrush" Value="Cyan"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4400FFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="MainPanel" Background="#80000000" CornerRadius="20" Padding="10" Margin="15" BorderThickness="1.5" BorderBrush="#33FFFFFF">
        <Border.CacheMode>
            <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False"/>
        </Border.CacheMode>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.8" Color="Black" RenderingBias="Performance"/>
        </Border.Effect>

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="menuLock" Header="Ghim Widget" Click="MenuLock_Click">
                    <MenuItem.Icon>
                        <TextBlock x:Name="iconLock" Text="🔒"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="menuAutoStart" Header="Khởi động cùng Windows" IsCheckable="True" Click="MenuAutoStart_Click"/>
                <Separator Background="#44FFFFFF"/>
                <MenuItem Header="Cài đặt độ mờ" Click="MenuSettings_Click"/>
                <MenuItem Header="Tải lại lịch" Click="MenuRefresh_Click"/>
                <MenuItem Header="Kiểm tra cập nhật" Click="BtnCheckUpdate_Click"/>
                <Separator Background="#44FFFFFF"/>
                <MenuItem Header="Thoát ứng dụng" Click="MenuExit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="HeaderPanel" Background="Transparent" MouseLeftButtonDown="HeaderPanel_MouseLeftButtonDown" Margin="10,0,10,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnPrevMonth" Content="◀" Style="{StaticResource MonthNavButtonStyle}" Click="BtnPrevMonth_Click" Margin="0,0,8,0"/>

                    <TextBlock x:Name="txtMonthYear" Text="THÁNG 3, 2026" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="TxtMonthYear_MouseLeftButtonUp">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="Cyan"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button x:Name="btnNextMonth" Content="▶" Style="{StaticResource MonthNavButtonStyle}" Click="BtnNextMonth_Click" Margin="8,0,0,0"/>

                    <Button x:Name="btnMainToday" Content="Hôm nay" Style="{StaticResource TagButtonStyle}" Click="BtnPickerToday_Click" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                    <TextBlock Text=" | " Foreground="#55FFFFFF" FontSize="20" Margin="15,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtClock" Text="00:00" Foreground="Beige" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

                    <Popup x:Name="popMonthYearPicker" AllowsTransparency="True" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=txtMonthYear}" VerticalOffset="5" Opened="PopMonthYearPicker_Opened" Closed="PopMonthYearPicker_Closed">
                        <Border Background="#F21A1A1A" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="12" Width="260" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Content="◀" Style="{StaticResource MonthNavButtonStyle}" Click="BtnPickerPrevYear_Click" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="txtPickerYear" Text="2026" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Content="▶" Style="{StaticResource MonthNavButtonStyle}" Click="BtnPickerNextYear_Click" FontSize="14" Margin="10,0,0,0"/>
                                    </StackPanel>

                                    <Button x:Name="btnPickerToday" Content="Hôm nay" Style="{StaticResource TagButtonStyle}" Click="BtnPickerToday_Click" HorizontalAlignment="Right" Padding="8,3" Margin="0" FontSize="11" Visibility="Collapsed"/>
                                </Grid>
                                <Separator Background="#22FFFFFF" Margin="0,0,0,8"/>
                                <UniformGrid Columns="3" Rows="4">
                                    <Button Content="Thg 1" Style="{StaticResource PickerMonthButtonStyle}" Click="BtnPickerMonth_Click" Tag="1"/>
                                    <Button Content="Thg 2" Style="{StaticResource PickerMonthButtonStyle}" Click="BtnPickerMonth_Click" Tag="2"/>
                                    <Button Content="Thg 3" Style="{StaticResource PickerMonthButtonStyle}" Click="BtnPickerMonth_Click" Tag="3"/>
                                    <Button Content="Thg 4" Style="{StaticResource PickerMonthButtonStyle}" Click="BtnPickerMonth_Click" Tag="4"/>
                                    <Button Content="Thg 5" Style="{StaticResource PickerMonthButtonStyle}" Click="BtnPickerMonth_Click" Tag="5"/>
                                    <Button Content="Thg 6" Style="{StaticResource PickerMonthButtonStyle}" Click="BtnPickerMonth_Click" Tag="6"/>
                                    <Button Content="Thg 7" Style="{StaticResource PickerMonthButtonStyle}" Click="BtnPickerMonth_Click" Tag="7"/>
                                    <Button Content="Thg 8" Style="{StaticResource PickerMonthButtonStyle}" Click="BtnPickerMonth_Click" Tag="8"/>
                                    <Button Content="Thg 9" Style="{StaticResource PickerMonthButtonStyle}" Click="BtnPickerMonth_Click" Tag="9"/>
                                    <Button Content="Thg 10" Style="{StaticResource PickerMonthButtonStyle}" Click="BtnPickerMonth_Click" Tag="10"/>
                                    <Button Content="Thg 11" Style="{StaticResource PickerMonthButtonStyle}" Click="BtnPickerMonth_Click" Tag="11"/>
                                    <Button Content="Thg 12" Style="{StaticResource PickerMonthButtonStyle}" Click="BtnPickerMonth_Click" Tag="12"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="brdReminder" Background="#4400FFFF" CornerRadius="10" Padding="12,4" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔 Sắp tới: " Foreground="#AAFFFFFF" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtNextEvent" Foreground="Cyan" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtEventTime" Foreground="White" FontSize="13" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Separator VerticalAlignment="Bottom" Background="#33FFFFFF" Margin="0,0,0,-8" Grid.ColumnSpan="2"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <UniformGrid Grid.Row="0" Grid.Column="1" Columns="7" Margin="0,0,0,5">
                    <TextBlock Text="Thứ 2" Foreground="#88FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Text="Thứ 3" Foreground="#88FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Text="Thứ 4" Foreground="#88FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Text="Thứ 5" Foreground="#88FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Text="Thứ 6" Foreground="#88FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Text="Thứ 7" Foreground="#88FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Text="CN" Foreground="#FFFF5555" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                </UniformGrid>

                <UniformGrid x:Name="WeekNumberGrid" Grid.Row="1" Grid.Column="0" Columns="1" Margin="0,0,5,0"/>
                <UniformGrid x:Name="CalendarGrid" Grid.Row="1" Grid.Column="1" Columns="7"/>

                <Border x:Name="brdLoadingCalendar" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#D5111111" CornerRadius="15" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25,15">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏳" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Đang tải lịch từ máy chủ, vui lòng đợi..." Foreground="Cyan" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="5,15,10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="5,0,0,10">
                        <TextBlock Text="•" Foreground="#4285F4" FontSize="18" VerticalAlignment="Center" Margin="0,-2,5,0"/>
                        <TextBlock Text="Kết quả cho " Foreground="#AAFFFFFF" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtLocationName" Text="Đang cập nhật..." Foreground="#E8EAED" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text=" · " Foreground="#AAFFFFFF" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Chọn khu vực" Foreground="#8AB4F8" FontSize="14" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="BtnOpenLocationPopup_Click"/>
                    </StackPanel>

                    <Border Background="Transparent" CornerRadius="12" Margin="5,0,0,0" MinWidth="420" ClipToBounds="True">
                        <Grid>
                            <Canvas x:Name="cvsWeatherEffects" IsHitTestVisible="False" Opacity="0.5">
                                <Canvas.CacheMode>
                                    <BitmapCache/>
                                </Canvas.CacheMode>
                            </Canvas>

                            <Grid Margin="10,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                                    <Path x:Name="pathWeatherIcon" Fill="White" Width="48" Height="48" Stretch="Uniform" Margin="0,0,10,0">
                                        <Path.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform x:Name="iconRotateTransform"/>
                                                <TranslateTransform x:Name="iconTranslateTransform"/>
                                            </TransformGroup>
                                        </Path.RenderTransform>
                                        <Path.Effect>
                                            <DropShadowEffect x:Name="weatherIconShadow" BlurRadius="15" ShadowDepth="0" Color="Gold" Opacity="0.8" RenderingBias="Quality"/>
                                        </Path.Effect>
                                    </Path>
                                    <TextBlock x:Name="txtTemperature" Text="--" Foreground="White" FontSize="52" FontWeight="Light" VerticalAlignment="Center"/>
                                    <TextBlock Text="°C" Foreground="#CCFFFFFF" FontSize="20" VerticalAlignment="Top" Margin="2,8,0,0"/>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Width="1" Fill="#33FFFFFF" Margin="0,5"/>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="15,0">
                                    <TextBlock x:Name="txtPrecip" Text="Khả năng có mưa: --%" Foreground="#AAAAAA" FontSize="12" Margin="0,2"/>
                                    <TextBlock x:Name="txtHumidity" Text="Đ度 ẩm: --%" Foreground="#AAAAAA" FontSize="12" Margin="0,2"/>
                                    <TextBlock x:Name="txtWind" Text="Gió: -- km/h" Foreground="#AAAAAA" FontSize="12" Margin="0,2"/>
                                </StackPanel>

                                <Rectangle Grid.Column="3" Width="1" Fill="#33FFFFFF" Margin="0,5"/>

                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="15,0,0,0">
                                    <TextBlock Text="Thời tiết" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="txtWeatherTime" Text="Cập nhật lúc: --:--" Foreground="#88FFFFFF" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="txtWeatherDesc" Text="Đang cập nhật..." Foreground="#4285F4" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Popup x:Name="popLocation" StaysOpen="False" AllowsTransparency="True" Placement="Top" VerticalOffset="-10">
                        <Border Background="#F2202124" CornerRadius="16" BorderBrush="#44FFFFFF" BorderThickness="1" Width="360" Padding="15">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="CHỌN KHU VỰC" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="✕" Click="BtnCloseLocationPopup_Click" Foreground="#88FFFFFF" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand" FontSize="16"/>
                                </Grid>

                                <Border Background="#33FFFFFF" CornerRadius="20" Padding="15,8" Margin="0,0,0,15" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Grid.Column="0" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Fill="#88FFFFFF" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                                        </Viewbox>
                                        <Grid Grid.Column="1">
                                            <TextBlock Text="Tìm kiếm địa điểm..." Foreground="#88FFFFFF" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=txtSearchLocation}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox x:Name="txtSearchLocation" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="13" VerticalAlignment="Center" KeyDown="TxtSearchLocation_KeyDown" TextChanged="TxtSearchLocation_TextChanged"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <ListBox x:Name="lstSuggestions" Visibility="Collapsed" MaxHeight="120" SelectionChanged="LstSuggestions_SelectionChanged" Background="Transparent" Foreground="White" BorderThickness="0" Margin="0,-10,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Vị trí hiện tại" Foreground="#AAFFFFFF" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>

                                <Button Click="BtnLocate_Click" Background="Transparent" BorderBrush="#1A73E8" BorderThickness="1" Cursor="Hand" Margin="0,0,0,15">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" ClipToBounds="True" Padding="10,6">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Path Fill="#1A73E8" Data="M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm8.94 3c-.46-4.17-3.77-7.48-7.94-7.94V1h-2v2.06C6.83 3.52 3.52 6.83 3.06 11H1v2h2.06c.46 4.17 3.77 7.48 7.94 7.94V23h2v-2.06c4.17-.46 7.48-3.77 7.94-7.94H23v-2h-2.06zM12 19c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z"/>
                                                    </Viewbox>
                                                    <TextBlock Text="Vị trí chính xác" Foreground="#1A73E8" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Khu vực lân cận" Foreground="#AAFFFFFF" FontSize="13" VerticalAlignment="Center"/>
                                    <Button Click="BtnRefreshLocations_Click" Content="⟳" Foreground="#88FFFFFF" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Làm mới"/>
                                </Grid>
                                <WrapPanel x:Name="wpPopularLocations" Margin="-4,0"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <TextBlock x:Name="txtMainProverb" Foreground="#BBE8EAED" FontSize="13" FontStyle="Italic" TextAlignment="Right" Margin="0,0,0,10" TextWrapping="Wrap" MaxWidth="300"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" BorderBrush="White" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Border.Background>
                                <ImageBrush x:Name="imgFooterProfile" ImageSource="pack://application:,,,/default_user.png"/>
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="txtFooterUserName" Text="Chế độ Khách" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!-- 🔄 NÚT CẬP NHẬT PHIÊN BẢN (Đã đồng bộ Height, Padding và Margin) -->
                        <Button x:Name="btnCheckUpdate" Content="🔄 Cập nhật" Click="BtnCheckUpdate_Click" 
                                Style="{StaticResource TagButtonStyle}" Height="30" Padding="10,0" Margin="0,0,8,0" 
                                VerticalAlignment="Center" ToolTip="Kiểm tra phiên bản mới"/>

                        <!-- 🔑 NÚT ĐĂNG NHẬP / ĐĂNG XUẤT (Đã đồng bộ Height, Padding và Margin) -->
                        <Button x:Name="btnAuthToggle" Content="Đăng nhập" Click="BtnAuthToggle_Click" 
                                Style="{StaticResource TagButtonStyle}" Height="30" Padding="10,0" Margin="0" 
                                VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                        <TextBlock x:Name="txtAppVersion" Foreground="#44FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBlock Text="Thiết kế và ý tưởng bởi Huỳnh Ngọc Thọ" Foreground="#44FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Viewbox Width="16" Height="16" Margin="4,0" Cursor="Hand" MouseLeftButtonDown="OpenTikTok_Click">
                            <Path Fill="#88FFFFFF" Data="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.17-2.86-.6-4.12-1.31a6.417 6.417 0 0 1-1.87-1.51v7.11a7.48 7.48 0 0 1-2.22 5.28c-1.41 1.4-3.3 2.22-5.28 2.3-1.98.08-3.96-.51-5.5-1.75a7.47 7.47 0 0 1-2.92-5.18c-.25-1.96.26-3.99 1.42-5.61 1.15-1.63 2.91-2.73 4.88-3.04.14-.02.28-.04.42-.05v4.1c-.13.02-.25.04-.37.08-1.07.27-1.99.98-2.52 1.95a4.015 4.015 0 0 0 .52 4.67 3.966 3.966 0 0 0 3.75 1.25c1.07-.27 1.97-1 2.51-1.95.31-.56.46-1.19.46-1.81V0l.02.02z"/>
                        </Viewbox>
                        <Viewbox Width="16" Height="16" Margin="6,0,0,0" Cursor="Hand" MouseLeftButtonDown="OpenFacebook_Click">
                            <Path Fill="#88FFFFFF" Data="M22.675 0H1.325C.593 0 0 .593 0 1.325v21.351C0 23.407.593 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116c.73 0 1.323-.593 1.323-1.325V1.325C24 .593 23.407 0 22.675 0z"/>
                        </Viewbox>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Popup x:Name="popEventDetail" Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
                <Border Background="#F21A1A1A" CornerRadius="15" BorderBrush="Cyan" BorderThickness="1" Width="340" Padding="15">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Button x:Name="btnBackToSummary" Content="⬅" Click="BtnBackToSummary_Click" Foreground="Cyan" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Visibility="Collapsed" Cursor="Hand" ToolTip="Quay lại danh sách"/>
                            <TextBlock x:Name="lblDetailTitle" Foreground="Cyan" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel x:Name="panelInfoList" Visibility="Collapsed" Margin="0,0,0,10">
                            <ItemsControl x:Name="itemsInfoEvents">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="📌 " Foreground="#88FFFFFF"/>
                                            <TextBlock Text="{Binding Summary}" Foreground="#BBBBBB" TextWrapping="Wrap" MaxWidth="280"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Background="#33FFFFFF" Margin="0,10,0,5"/>
                        </StackPanel>

                        <StackPanel x:Name="panelEventList" Visibility="Collapsed" Margin="0,0,0,10">
                            <TextBlock x:Name="lblEventSectionTitle" Text="Lịch trình của bạn:" Foreground="Cyan" FontSize="13" Opacity="0.7" Margin="0,0,0,5"/>
                            <ItemsControl x:Name="itemsPopupEvents">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Click="EventListItem_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔹 " Foreground="Cyan"/>
                                                    <TextBlock Text="{Binding Summary}" Foreground="White" TextDecorations="Underline" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Content="✏️" Click="BtnEditSpecificEvent_Click" Tag="{Binding}" Foreground="Yellow" Background="Transparent" BorderThickness="0" Margin="5,0" ToolTip="Sửa"/>
                                            <Button Grid.Column="2" Content="🗑️" Click="BtnDeleteSpecificEvent_Click" Tag="{Binding}" Foreground="#FF5555" Background="Transparent" BorderThickness="0" ToolTip="Xóa"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="panelSingleDetail">
                            <Grid Margin="0,0,0,6">
                                <TextBlock x:Name="lblEventSummaryDisplay" Foreground="White" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="240" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button x:Name="btnEditCurrentEvent" Content="✏️" Click="BtnEditCurrentEvent_Click" Foreground="Yellow" Background="Transparent" BorderThickness="0" Margin="0,0,8,0" ToolTip="Sửa" Visibility="Collapsed"/>
                                    <Button x:Name="btnDeleteEvent" Content="🗑️" Click="BtnDeleteCurrentEvent_Click" Foreground="#FF5555" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Xóa" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="lblDetailTimeDisplay" Foreground="#A0A0A0" FontSize="13" Margin="0,0,0,10"/>

                            <StackPanel x:Name="panelDetailLocation" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
                                <TextBlock Text="📍 " Foreground="Cyan" VerticalAlignment="Center"/>
                                <TextBlock FontSize="13" VerticalAlignment="Center" MaxWidth="280">
                                    <Hyperlink x:Name="lnkLocationMaps" Foreground="#0A84FF" TextDecorations="{x:Null}" Click="LnkLocationMaps_Click">
                                        <Hyperlink.ToolTip>
                                            <ToolTip Content="Xem trên bản đồ" Background="#1A1A1A" Foreground="#E0E0E0" BorderBrush="#44FFFFFF"/>
                                        </Hyperlink.ToolTip>
                                        <TextBlock x:Name="lblDetailLocation" Text="Địa chỉ ở đây"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel x:Name="panelAttendeesSection" Margin="0,0,0,10" Visibility="Collapsed">
                                <TextBlock Text="Người tham gia:" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ItemsControl x:Name="itemsAttendeesList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" IsItemsHost="True"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,8,2">
                                                <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding StatusColor}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Email}" Foreground="#E0E0E0" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="125">
                                                    <TextBlock.ToolTip>
                                                        <ToolTip Content="{Binding DisplayName}" Background="#1A1A1A" Foreground="#E0E0E0" BorderBrush="#44FFFFFF"/>
                                                    </TextBlock.ToolTip>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock x:Name="lblDetailNotes" Foreground="#88FFFFFF" FontStyle="Italic" TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="🕒" FontSize="20" Click="BtnShowDeletedHistory_Click" Foreground="#88FFFFFF" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Sự kiện xóa gần đây"/>

                            <Button Grid.Column="1" x:Name="btnAddEventPopup" Content="➕ Thêm mới" Click="BtnAddEventPopup_Click" Foreground="Cyan" Background="#2200FFFF" Padding="12,4" HorizontalAlignment="Center" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <StackPanel x:Name="panelMainGuestNotice" Margin="0,12,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💡 Bạn đang ở Chế độ khách. " Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                <Button Content="Đăng nhập ngay" Foreground="Cyan" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="11" Click="BtnMainLoginNotice_Click" VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="để đồng bộ dữ liệu đám mây Cloud toàn cầu." Foreground="#44FFFFFF" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Content="Đóng" Click="BtnCloseDetail_Click" Foreground="#55FFFFFF" Background="Transparent" BorderThickness="0" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Popup>

            <Grid x:Name="WelcomeOverlay" Grid.RowSpan="3" Panel.ZIndex="100" Background="#F41A1A1A" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="100" Height="100" CornerRadius="50" BorderBrush="Cyan" BorderThickness="2" Margin="0,0,0,20">
                        <Border.Background>
                            <ImageBrush x:Name="imgProfile" ImageSource="pack://application:,,,/default_user.png"/>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="txtWelcomeUser" Text="Xin chào!" Foreground="White" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtProverb" Foreground="Cyan" FontSize="18" FontStyle="Italic" TextAlignment="Center" MaxWidth="500" TextWrapping="Wrap"/>

                    <StackPanel x:Name="panelWelcomeActions" Margin="0,25,0,0" HorizontalAlignment="Center">
                        <Button Content="🔑 Đăng nhập bằng Google" Style="{StaticResource WelcomeGoogleButtonStyle}" Click="BtnWelcomeLogin_Click"/>
                        <TextBlock Text="(Đồng bộ lịch cá nhân trên Google của bạn)" Foreground="#55FFFFFF" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,15"/>

                        <Button Content="👤 Tiếp tục Chế độ khách" Style="{StaticResource TagButtonStyle}" Click="BtnWelcomeGuest_Click" Width="200" HorizontalAlignment="Center"/>
                        <TextBlock Text="(Lịch sẽ chỉ lưu nội bộ trên máy tính này)" Foreground="#33FFFFFF" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="AuthorPanel">
                        <Separator Background="#22FFFFFF" Width="200" Margin="0,20"/>
                        <TextBlock Text="Thiết kế và ý tưởng bởi Huỳnh Ngọc Thọ" Foreground="#44FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>