<Window x:Class="MyCalendarWidget.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cập nhật phiên bản" 
        Height="540" Width="480" MinHeight="500" MinWidth="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Border Background="#F4181818" CornerRadius="18" BorderBrush="#4400FFFF" BorderThickness="1.5" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="Black" Opacity="0.85"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔄 " FontSize="18"/>
                    <TextBlock Text="CÁC PHIÊN BẢN" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" Click="BtnClose_Click" Foreground="#88FFFFFF" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" FontSize="16" Cursor="Hand"/>
            </Grid>

            <!-- Danh sách cuộn toàn bộ phiên bản -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                <StackPanel>
                    <!-- KHỐI 1: PHIÊN BẢN MỚI NHẤT TRÊN CÙNG -->
                    <Border x:Name="brdLatestVersion" Background="#2200FFFF" CornerRadius="12" BorderBrush="Cyan" BorderThickness="1" Padding="14" Margin="0,0,0,15">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⭐ " FontSize="16"/>
                                    <TextBlock x:Name="txtLatestVerTitle" Text="Phiên bản mới nhất" Foreground="Cyan" FontSize="15" FontWeight="Bold"/>
                                </StackPanel>
                                <Border x:Name="brdBadgeLatest" Background="#4434C759" CornerRadius="8" HorizontalAlignment="Right" Padding="8,2">
                                    <TextBlock x:Name="txtLatestBadge" Text="MỚI NHẤT" Foreground="#34C759" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="Mô tả cập nhật:" Foreground="#88FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Border Background="#1A000000" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                <TextBlock x:Name="txtLatestNotes" Text="Đang tải ghi chú cập nhật..." Foreground="#E0E0E0" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"/>
                            </Border>

                            <Button x:Name="btnDownloadLatest" Content="⚡ Cập nhật" Click="BtnDownloadLatest_Click"
                                    Foreground="Black" Background="Cyan" FontWeight="Bold" FontSize="13" Padding="15,7" Cursor="Hand" HorizontalAlignment="Right">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- KHỐI 2: TIÊU ĐỀ PHIÊN BẢN CŨ HƠN -->
                    <StackPanel x:Name="panelOlderHeader" Margin="0,5,0,8" Visibility="Collapsed">
                        <Grid>
                            <Separator Background="#33FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Text=" PHIÊN BẢN CŨ HƠN " Background="#181818" Foreground="#88FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Padding="8,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- KHỐI 3: DANH SÁCH BẢN CŨ -->
                    <ItemsControl x:Name="itemsOlderVersions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#15FFFFFF" CornerRadius="10" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{Binding VersionTitle}" Foreground="White" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Content="{Binding ButtonText}" IsEnabled="{Binding IsInstallEnabled}" Click="BtnDownloadSpecific_Click" Tag="{Binding DownloadUrl}"
                                                    Foreground="{Binding ButtonForeground}" Background="Transparent" BorderBrush="{Binding ButtonForeground}" BorderThickness="1"
                                                    FontSize="11" Padding="8,3" Cursor="Hand" HorizontalAlignment="Right" Opacity="{Binding ButtonOpacity}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <TextBlock Text="{Binding ReleaseNotes}" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Thanh tiến trình tải khi người dùng bấm tải -->
            <StackPanel Grid.Row="2" x:Name="panelDownloading" Visibility="Collapsed">
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="txtDownloadStatus" Text="Đang tải tệp cài đặt..." Foreground="Cyan" FontSize="12"/>
                    <TextBlock x:Name="txtProgressPercent" Text="0%" Foreground="White" FontSize="12" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="pbDownload" Height="6" Value="0" Maximum="100" Foreground="Cyan" Background="#33FFFFFF" BorderThickness="0"/>
            </StackPanel>

            <!-- HỘP THOẠI XÁC NHẬN CẬP NHẬT / GỠ BẢN CŨ -->
            <Grid Grid.RowSpan="3" x:Name="overlayConfirm" Background="#D5000000" Visibility="Collapsed">
                <Border Background="#202020" BorderBrush="Cyan" BorderThickness="1.5" CornerRadius="14" Width="380" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="⚠️ XÁC NHẬN CÀI ĐẶT" Foreground="Yellow" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Khi cập nhật sẽ gỡ bỏ bản cũ và cài đè phiên bản mới này vào hệ thống của bạn." Foreground="White" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" LineHeight="18"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Hủy" Click="BtnCancelConfirm_Click" Background="#33FFFFFF" Foreground="White" BorderThickness="0" Padding="15,6" Cursor="Hand" Margin="0,0,12,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="Đồng ý" Click="BtnAcceptConfirm_Click" Background="Cyan" Foreground="Black" FontWeight="Bold" BorderThickness="0" Padding="20,6" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>